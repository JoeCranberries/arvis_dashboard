# Copy this file to ".env.local" and fill in the values. .env.local is git-ignored.

# MongoDB Atlas: Cluster → Connect → Drivers → copy the connection string.
# Replace username/password (URL-encode special chars: % -> %25, @ -> %40, etc.).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name (created automatically on first write).
MONGODB_DB="arvi_dashboard"

# Secret for signing the access-code session cookie.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"
