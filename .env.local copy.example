# Copy this file to ".env.local" and fill in your MongoDB Atlas connection string.
# .env.local is git-ignored, so your secret stays local.

# From Atlas: Cluster → Connect → Drivers → copy the connection string.
# Replace <username>, <password>, and the cluster host. Keep the /?... options.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name (created automatically on first write).
MONGODB_DB="arvi_dashboard"
